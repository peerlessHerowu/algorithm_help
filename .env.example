# ============================================
# 算法深度理解引擎 - 环境变量配置
# ============================================
# 使用方式：cp .env.example .env，然后填写实际值
# ============================================

# ------------------------------------------
# 数据库配置
# ------------------------------------------
# MySQL 普通用户（应用连接使用）
DB_USER=admin
DB_PASSWORD=your_db_password_here
# MySQL root 密码（初始化和备份使用）
DB_ROOT_PASSWORD=your_root_password_here
# 数据库端口（默认 3306）
DB_PORT=3306

# ------------------------------------------
# Redis 配置
# ------------------------------------------
REDIS_PORT=6379

# ------------------------------------------
# 服务端口
# ------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
CRAWLER_PORT=8200

# ------------------------------------------
# MinIO 对象存储配置
# ------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ------------------------------------------
# AI Provider 配置
# ------------------------------------------
# OpenAI / DeepSeek API Key
OPENAI_API_KEY=sk-your-openai-key-here
# OpenAI 兼容端点（DeepSeek 可填 https://api.deepseek.com）
OPENAI_BASE_URL=https://api.openai.com
# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# 本地 Ollama 地址（Docker 环境下使用 host.docker.internal）
OLLAMA_HOST=http://host.docker.internal:11434

# ------------------------------------------
# 安全配置
# ------------------------------------------
# JWT 签名密钥（至少 256 位随机字符串）
# 生成方式：openssl rand -base64 48
JWT_SECRET=your_jwt_secret_at_least_32_chars_long_here
